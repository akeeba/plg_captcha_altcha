{
	"name": "akeeba/plg_captcha_google",
	"type": "project",
	"description": "Joomla! plugin to implement ALTCHA, the Open Source, proof-of-work, self-hosted CAPTCHA alternative",
	"keywords": [
		"joomla",
		"plugin",
		"captcha",
		"altcha"
	],
	"homepage": "https://github.com/akeeba/plg_captcha_altcha",
	"license": "GPL-3.0-or-later",
	"minimum-stability": "stable",
	"authors": [
		{
			"name": "Nicholas K. Dionysopoulos",
			"email": "nicholas_NOSPAM@akeeba.com",
			"homepage": "http://www.akeeba.com",
			"role": "Lead Developer"

		}
	],
	"support": {
		"issues": "https://github.com/akeeba/plg_captcha_altcha/issues",
		"wiki": "https://github.com/akeeba/plg_captcha_altcha/wiki",
		"security": "https://github.com/akeeba/plg_captcha_altcha/security/policy",
		"source": "https://github.com/plg_captcha_altcha/panopticon"
	},
	"funding": [
		{
			"type": "paypal",
			"url": "https://www.paypal.com/donate/?hosted_button_id=NFUWUURA6X3TS"
		}
	],
	"require": {
		"php": ">=8.2 <8.7",
		"ext-simplexml": "*",
		"altcha-org/altcha": "^v1.3.1"
	},
	"require-dev": {
		"coenjacobs/mozart": "^0.7.1"
	},
	"config": {
		"optimize-autoloader": false,
		"platform": {
			"php": "8.2.999"
		}
	},
	"extra": {
		"mozart": {
			"dep_namespace": "Akeeba\\Plugin\\Captcha\\Altcha\\Dependency\\",
			"dep_directory": "//plugins/captcha/altcha/src/Dependency/",
			"classmap_directory": "//plugins/captcha/altcha/src/Dependency/classmap/",
			"packages": [
				"altcha-org/altcha"
			]
		},
		"akcompat": {
			"limit_type": "joomla",
			"limit": ">=5.4.0 <6.2",
			"locations": [
				{
					"file": "plugins/captcha/altcha/altcha.script.php",
					"type": "variable",
					"marker": "$minimumPhp",
					"value": "PHP_MIN"
				},
				{
					"file": "plugins/captcha/altcha/altcha.script.php",
					"type": "variable",
					"marker": "$maximumPhp",
					"value": "PHP_MAX"
				},
				{
					"file": "plugins/captcha/altcha/altcha.script.php",
					"type": "variable",
					"marker": "$minimumJoomla",
					"value": "LIMIT_MIN"
				},
				{
					"file": "plugins/captcha/altcha/altcha.script.php",
					"type": "variable",
					"marker": "$maximumJoomla",
					"value": "LIMIT_MAX"
				}
			]
		}
	}
}